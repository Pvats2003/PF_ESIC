{
  "name": "pf-esic-desk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run -c vitest.db.config.mts",
    "test:e2e": "playwright test --trace off",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:db",
    "db:seed-demo": "tsx --env-file-if-exists=.env.local scripts/seed-demo.ts",
    "user:add": "tsx --env-file-if-exists=.env.local scripts/add-user.ts",
    "screenshots": "tsx scripts/screenshot.ts",
    "icons": "tsx scripts/make-icons.ts",
    "import:map": "tsx scripts/import-excel.ts map",
    "import:apply": "tsx --env-file-if-exists=.env.local scripts/import-excel.ts apply",
    "import:clients": "tsx --env-file-if-exists=.env.local scripts/import-clients.ts",
    "dev:db": "tsx scripts/dev-local.ts",
    "dev:local": "LOCAL_DATABASE_URL=postgres://postgres:postgres@localhost:5432/pfesic_dev LOCAL_DEMO_USER_ID=00000000-0000-4000-8000-00000000000a next dev"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.8",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "exceljs": "^4.4.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
