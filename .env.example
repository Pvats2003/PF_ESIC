# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only. Used by scripts (add-user, import). Never expose to the browser.
SUPABASE_SECRET_KEY=your-service-role-or-secret-key

# Direct Postgres connection for scripts (import, demo seed).
# Local Supabase CLI default shown; for the hosted project use the "Session pooler" string.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Tests only: a throwaway Postgres server for migration/RLS tests (no Supabase needed).
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
